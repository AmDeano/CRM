@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to Simple CRM</h1>
    <p class="lead">Manage your clients, projects, and tasks efficiently.</p>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="mt-5">
            <a class="btn btn-primary btn-lg me-3" href="/Identity/Account/Register">Get Started</a>
            <a class="btn btn-outline-primary btn-lg" href="/Identity/Account/Login">Login</a>
        </div>
    }
    else
    {
        <div class="mt-5">
            <a class="btn btn-success btn-lg" asp-controller="Clients" asp-action="Index">Go to Clients</a>
        </div>
    }
</div>